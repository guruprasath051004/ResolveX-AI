# ── Database ──
POSTGRES_USER=resolvex
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
POSTGRES_DB=resolvexdb
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ── Auth ──
JWT_SECRET_KEY=replace-with-a-long-random-signing-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_EMPLOYEE_PASSWORD=Demo123
DEMO_SUPPORT_PASSWORD=Demo123
DEMO_ADMIN_PASSWORD=Demo123

# ── LLM Provider ──
# Options: demo | anthropic | openai | gemini
LLM_PROVIDER=demo

# Uncomment the provider you want and set the key:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AI...

# ── MCP Server ──
MCP_SERVER_URL=http://localhost:8001

# ── ChromaDB ──
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=resolvex_docs

